{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Poha",
  "mainBinaryName": "poha",
  "identifier": "com.iamadig.poha",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Poha",
        "width": 1100,
        "height": 720,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/poha-diarizer"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
